@model CVAnalyzer.Application.DTOs.CV.BulkCVUploadDto

@{
    ViewData["Title"] = "Bulk Upload CVs";
}

<div class="row">
    <div class="col-md-10 offset-md-1">
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0"><i class="fas fa-file-upload"></i> Bulk Upload Student CVs</h4>
            </div>
            <div class="card-body">
                <form method="post" asp-action="BulkUpload" enctype="multipart/form-data" id="bulkUploadForm">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="CVFiles" class="form-label">Select CV Files <span class="text-danger">*</span></label>
                        <input asp-for="CVFiles" type="file" class="form-control" accept=".pdf,.docx"
                               multiple onchange="displaySelectedFiles(this)" />
                        <span asp-validation-for="CVFiles" class="text-danger"></span>
                        <div class="form-text">
                            <i class="fas fa-info-circle"></i> Select multiple PDF or DOCX files. Hold Ctrl/Cmd to select multiple files.
                        </div>
                    </div>

                    <div id="filesPreview" class="mb-3"></div>

                    <div class="form-check form-switch mb-3">
                        <input asp-for="AutoExtractStudentInfo" class="form-check-input" type="checkbox" checked />
                        <label asp-for="AutoExtractStudentInfo" class="form-check-label">
                            Automatically extract student information from CVs
                        </label>
                        <div class="form-text">
                            If unchecked, filenames will be used as student IDs
                        </div>
                    </div>

                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle"></i> <strong>Note:</strong> Processing multiple CVs may take some time. Please be patient.
                    </div>

                    <div id="progressBar" class="mb-3" style="display: none;">
                        <div class="progress">
                            <div class="progress-bar progress-bar-striped progress-bar-animated"
                                 role="progressbar" style="width: 0%" id="uploadProgress">
                                0%
                            </div>
                        </div>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-times"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-success" id="bulkUploadBtn">
                            <i class="fas fa-cloud-upload-alt"></i> Upload All
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function displaySelectedFiles(input) {
            const preview = document.getElementById('filesPreview');
            preview.innerHTML = '';

            if (input.files && input.files.length > 0) {
                let totalSize = 0;
                let html = '<div class="card"><div class="card-body"><h6>Selected Files:</h6><ul class="list-group">';

                for (let i = 0; i < input.files.length; i++) {
                    const file = input.files[i];
                    const sizeMB = (file.size / 1024 / 1024).toFixed(2);
                    totalSize += file.size;

                    html += `
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span><i class="fas fa-file-pdf text-danger"></i> ${file.name}</span>
                            <span class="badge bg-primary rounded-pill">${sizeMB} MB</span>
                        </li>
                    `;
                }

                const totalSizeMB = (totalSize / 1024 / 1024).toFixed(2);
                html += `</ul><div class="mt-3"><strong>Total:</strong> ${input.files.length} files (${totalSizeMB} MB)</div></div></div>`;
                preview.innerHTML = html;
            }
        }

        document.getElementById('bulkUploadForm').addEventListener('submit', function() {
            const btn = document.getElementById('bulkUploadBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Uploading...';

            document.getElementById('progressBar').style.display = 'block';
            simulateProgress();
        });

        function simulateProgress() {
            let progress = 0;
            const interval = setInterval(() => {
                progress += 5;
                if (progress > 90) {
                    clearInterval(interval);
                } else {
                    document.getElementById('uploadProgress').style.width = progress + '%';
                    document.getElementById('uploadProgress').textContent = progress + '%';
                }
            }, 500);
        }
    </script>
}
