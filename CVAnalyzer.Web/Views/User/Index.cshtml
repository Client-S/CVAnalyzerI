@model IEnumerable<CVAnalyzer.Application.DTOs.User.UserListDto>

@{
    ViewData["Title"] = "User Management";
}

<div class="row mb-4">
    <div class="col-md-8">
        <h2><i class="fas fa-users-cog"></i> User Management</h2>
        <p class="text-muted">Manage system users and their roles</p>
    </div>
    <div class="col-md-4 text-end">
        <a asp-controller="Auth" asp-action="Register" class="btn btn-primary">
            <i class="fas fa-user-plus"></i> Add New User
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover" id="usersTable">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Department</th>
                        <th>Roles</th>
                        <th>Status</th>
                        <th>Last Login</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>
                                <strong>@user.FullName</strong>
                            </td>
                            <td>@user.Email</td>
                            <td>@user.Department</td>
                            <td>
                                @foreach (var role in user.Roles)
                                {
                                    <span class="badge bg-info me-1">@role</span>
                                }
                            </td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td>
                                @if (user.LastLoginDate.HasValue)
                                {
                                    @user.LastLoginDate.Value.ToString("MMM dd, yyyy")
                                }
                                else
                                {
                                    <span class="text-muted">Never</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Edit" asp-route-id="@user.Id" 
                                       class="btn btn-outline-primary" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    
                                    @if (user.IsActive)
                                    {
                                        <form method="post" asp-action="Deactivate" asp-route-id="@user.Id" 
                                              class="d-inline" onsubmit="return confirm('Deactivate this user?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-warning" title="Deactivate">
                                                <i class="fas fa-ban"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post" asp-action="Activate" asp-route-id="@user.Id" 
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-success" title="Activate">
                                                <i class="fas fa-check"></i>
                                            </button>
                                        </form>
                                    }

                                    <a asp-action="ResetPassword" asp-route-id="@user.Id" 
                                       class="btn btn-outline-info" title="Reset Password">
                                        <i class="fas fa-key"></i>
                                    </a>
                                    
                                    <form method="post" asp-action="Delete" asp-route-id="@user.Id" 
                                          class="d-inline" onsubmit="return confirm('Are you sure you want to delete this user?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#usersTable').DataTable({
                responsive: true,
                order: [[0, 'asc']],
                pageLength: 25
            });
        });
    </script>
}