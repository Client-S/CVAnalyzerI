@model IEnumerable<CVAnalyzer.Application.DTOs.Cluster.ClusterDto>

@{
    ViewData["Title"] = "Student Clusters";
}

<div class="row mb-4">
    <div class="col-md-8">
        <h2><i class="fas fa-project-diagram"></i> Student Clusters</h2>
        <p class="text-muted">Group students by similar skills and experience</p>
    </div>
    <div class="col-md-4 text-end">
        <div class="btn-group" role="group">
            <a asp-action="CreateML" class="btn btn-primary">
                <i class="fas fa-brain"></i> Create New Cluster
            </a>
            <a asp-action="Create" class="btn btn-outline-primary">
                <i class="fas fa-plus"></i> Simple Cluster
            </a>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="fas fa-project-diagram fa-4x text-muted mb-3"></i>
            <h4>No Clusters Yet</h4>
            <p class="text-muted">Create your first cluster to group students by skills</p>
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> Create First Cluster
            </a>
        </div>
    </div>
}
else
{
    <div class="row">
        @foreach (var cluster in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-layer-group"></i> @cluster.ClusterName
                        </h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted">@cluster.Description</p>

                        <div class="mb-3">
                            <strong><i class="fas fa-users"></i> Students:</strong>
                            <span class="badge bg-info ms-2">@cluster.StudentCount</span>
                        </div>

                        @if (cluster.CommonSkills.Any())
                        {
                            <div class="mb-3">
                                <strong><i class="fas fa-code"></i> Common Skills:</strong>
                                <div class="mt-2">
                                    @foreach (var skill in cluster.CommonSkills)
                                    {
                                        <span class="badge bg-success me-1">@skill</span>
                                    }
                                </div>
                            </div>
                        }

                        <small class="text-muted">
                            <i class="fas fa-calendar"></i> Created: @cluster.CreatedDate.ToString("MMM dd, yyyy")
                        </small>
                    </div>
                    <div class="card-footer bg-white">
                        <div class="d-flex justify-content-between">
                            <a asp-action="Details" asp-route-id="@cluster.Id" class="btn btn-sm btn-outline-primary">
                                <i class="fas fa-eye"></i> View Details
                            </a>
                            <div>
                                <a asp-controller="Report" asp-action="ExportCluster" asp-route-id="@cluster.Id"
                                   class="btn btn-sm btn-outline-success">
                                    <i class="fas fa-file-excel"></i> Export
                                </a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <form method="post" asp-action="Delete" asp-route-id="@cluster.Id"
                                          class="d-inline" onsubmit="return confirm('Delete this cluster?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}